<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Camera Preview (Takes left majority of landscape screen) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottom_control_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Overlay Bar over Preview -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/top_bar_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottom_control_panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_camera_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <!-- Plate: Monospace -->
            <TextView
                android:id="@+id/tv_camera_plate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Plate Color Chip -->
            <TextView
                android:id="@+id/tv_camera_plate_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Rotate Screen Button -->
            <ImageButton
                android:id="@+id/btn_camera_rotate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Xoay màn hình"
                android:src="@drawable/ic_screen_rotation"
                app:tint="@color/primary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Side Control Panel (Right Side for Thumb Access) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottom_control_panel"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:background="@color/surface"
        android:elevation="8dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Review Button at top of panel -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_review"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:text="@string/btn_review"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                app:backgroundTint="@color/primary"
                app:cornerRadius="6dp" />

            <!-- Rear 45° -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rear_45"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="4dp"
                android:text="@string/photo_rear_45"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/status_empty_bg"
                app:strokeColor="@color/status_empty_stroke"
                app:strokeWidth="1.5dp"
                app:cornerRadius="6dp" />

            <!-- Front 45° -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_front_45"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="4dp"
                android:text="@string/photo_front_45"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/status_empty_bg"
                app:strokeColor="@color/status_empty_stroke"
                app:strokeWidth="1.5dp"
                app:cornerRadius="6dp" />

            <!-- Chassis -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chassis"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="4dp"
                android:text="@string/photo_chassis"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/status_empty_bg"
                app:strokeColor="@color/status_empty_stroke"
                app:strokeWidth="1.5dp"
                app:cornerRadius="6dp" />

            <!-- Passenger -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_passenger"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="4dp"
                android:text="@string/photo_passenger"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/status_empty_bg"
                app:strokeColor="@color/status_empty_stroke"
                app:strokeWidth="1.5dp"
                app:cornerRadius="6dp" />

            <!-- New Vehicle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_vehicle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="4dp"
                android:text="@string/photo_new_vehicle"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/status_empty_bg"
                app:strokeColor="@color/status_empty_stroke"
                app:strokeWidth="1.5dp"
                app:cornerRadius="6dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Uploading / Processing Overlay -->
    <FrameLayout
        android:id="@+id/layout_camera_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_plate_badge"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/tv_camera_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/uploading"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
