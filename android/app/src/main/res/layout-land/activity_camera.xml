<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview: 100% Unobstructed Full Screen on Left Side -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottom_control_panel" />

    <!-- Side Control Panel: On the Right Side -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottom_control_panel"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:elevation="8dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Top Header inside Buttons Panel: Back Button + Plate & Color -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plate_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp"
                android:layout_marginBottom="8dp">

                <ImageButton
                    android:id="@+id/btn_camera_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Quay lại"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/primary" />

                <!-- Plate & Color Text -->
                <TextView
                    android:id="@+id/tv_camera_plate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:textColor="@color/primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="4dp" />

            </LinearLayout>

            <!-- Review Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_review"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_review"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                app:backgroundTint="@color/status_done_text"
                app:cornerRadius="6dp" />

            <!-- Capture Button 1: Rear 45° -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rear_45"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:text="@string/photo_rear_45"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/status_empty_bg"
                app:strokeColor="@color/status_empty_stroke"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Capture Button 2: Front 45° -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_front_45"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:text="@string/photo_front_45"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/status_empty_bg"
                app:strokeColor="@color/status_empty_stroke"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Capture Button 3: Passenger -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_passenger"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:text="@string/photo_passenger"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/status_empty_bg"
                app:strokeColor="@color/status_empty_stroke"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Capture Button 4: New Vehicle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_vehicle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="@string/photo_new_vehicle"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/status_empty_bg"
                app:strokeColor="@color/status_empty_stroke"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Uploading / Processing Overlay -->
    <FrameLayout
        android:id="@+id/layout_camera_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_plate_badge"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/tv_camera_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/uploading"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
